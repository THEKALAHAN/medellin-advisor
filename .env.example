# Copiar a .env.local. Ninguna variable es obligatoria.

# URL pública definitiva (canonical, Open Graph, sitemap.xml y robots.txt).
# En Vercel, si no se define, se usa VERCEL_PROJECT_PRODUCTION_URL; en local, http://localhost:3000.
# SITE_URL=https://www.ejemplo.com

# Tiempo máximo por consulta a ArcGIS, en milisegundos (1–60000). Por defecto: 10000.
# ARCGIS_TIMEOUT_MS=10000
